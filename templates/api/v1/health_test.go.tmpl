package v1

import (
	"context"
	"errors"
	"net/http/httptest"
	"strings"
	"testing"
	"time"

	"github.com/gin-gonic/gin"
)

func TestHealthDoesNotDependOnDatabase(t *testing.T) {
	gin.SetMode(gin.TestMode)
	h := Handler{Ready: func(context.Context) error { t.Fatal("liveness contacted database"); return nil }}
	router := gin.New()
	router.GET("/healthz", h.Health())
	response := httptest.NewRecorder()
	router.ServeHTTP(response, httptest.NewRequest("GET", "/healthz", nil))
	if response.Code != 200 || !strings.Contains(response.Body.String(), `"status":"ok"`) {
		t.Fatalf("%d: %s", response.Code, response.Body.String())
	}
}

func TestReadiness(t *testing.T) {
	for _, tc := range []struct {
		name   string
		check  func(context.Context) error
		status int
	}{
		{"healthy", func(ctx context.Context) error {
			if deadline, ok := ctx.Deadline(); !ok || time.Until(deadline) > 50*time.Millisecond {
				t.Error("missing short timeout")
			}
			return nil
		}, 200},
		{"unavailable", func(context.Context) error { return errors.New("secret database detail") }, 503},
		{"timeout", func(ctx context.Context) error { <-ctx.Done(); return ctx.Err() }, 503},
	} {
		t.Run(tc.name, func(t *testing.T) {
			h := Handler{Ready: tc.check, ReadinessTimeout: 50 * time.Millisecond}
			router := gin.New()
			router.GET("/readyz", h.Readiness())
			response := httptest.NewRecorder()
			router.ServeHTTP(response, httptest.NewRequest("GET", "/readyz", nil))
			if response.Code != tc.status || strings.Contains(response.Body.String(), "secret") {
				t.Fatalf("%d: %s", response.Code, response.Body.String())
			}
		})
	}
}

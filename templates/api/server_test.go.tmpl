type recordingLogger struct {
	infos  []string
	errs   []error
	fields map[string]any
}

func (l *recordingLogger) With(fields map[string]any) services.Logger { l.fields = fields; return l }

func (l *recordingLogger) Info(msg string)           { l.infos = append(l.infos, msg) }
func (*recordingLogger) Debug(string)                {}
func (*recordingLogger) Warn(string)                 {}
func (l *recordingLogger) Error(_ string, err error) { l.errs = append(l.errs, err) }

func TestRouterMiddleware(t *testing.T) {
	for _, env := range []string{configs.DEVELOPMENT, configs.PRODUCTION} {
		t.Run(env, func(t *testing.T) {
			defer gin.SetMode(gin.TestMode)
			log := &recordingLogger{}
			router := initializeRouter(configs.Config{Env: env, CORSOrigins: []string{"*"}, MaxBodyBytes: 1 << 20, HTTPRequestTimeout: time.Second}, log)
			router.GET("/ok", func(c *gin.Context) { c.Status(http.StatusNoContent) })
			router.GET("/panic", func(*gin.Context) { panic("handler failed") })
			for _, tc := range []struct {
				path   string
				status int
			}{
				{"/ok", http.StatusNoContent}, {"/panic", http.StatusInternalServerError},
			} {
				request := httptest.NewRequest(http.MethodGet, tc.path, nil)
				request.Header.Set("Origin", "https://frontend.example.com")
				recorder := httptest.NewRecorder()
				router.ServeHTTP(recorder, request)
				if recorder.Code != tc.status {
					t.Fatalf("%s: got %d, want %d", tc.path, recorder.Code, tc.status)
				}
				if recorder.Header().Get("Access-Control-Allow-Origin") != "*" {
					t.Fatal("CORS middleware missing")
				}
				if recorder.Header().Get("Access-Control-Allow-Credentials") != "" {
					t.Fatal("wildcard CORS must not allow credentials")
				}
			}
			if len(log.infos) != 2 {
				t.Fatalf("want one access log per request, got %d", len(log.infos))
			}
			if len(log.errs) != 1 || !strings.Contains(log.errs[0].Error(), "handler failed") {
				t.Fatalf("want one panic error log, got %v", log.errs)
			}
			request := httptest.NewRequest(http.MethodOptions, "/ok", nil)
			request.Header.Set("Origin", "https://frontend.example.com")
			request.Header.Set("Access-Control-Request-Method", "GET")
			recorder := httptest.NewRecorder()
			router.ServeHTTP(recorder, request)
			if recorder.Code != http.StatusNoContent {
				t.Fatalf("preflight status: %d", recorder.Code)
			}
		})
	}
}

type stubHTTPServer struct {
	listen   func() error
	shutdown func(context.Context) error
	close    func() error
}

func (s stubHTTPServer) ListenAndServe() error              { return s.listen() }
func (s stubHTTPServer) Shutdown(ctx context.Context) error { return s.shutdown(ctx) }
func (s stubHTTPServer) Close() error                       { return s.close() }

func awaitServe(t *testing.T, result <-chan error) error {
	t.Helper()
	select {
	case err := <-result:
		return err
	case <-time.After(2 * time.Second):
		t.Fatal("server did not return promptly")
		return nil
	}
}

func TestServeReturnsListenerFailure(t *testing.T) {
	listenErr := errors.New("address already in use")
	server := stubHTTPServer{listen: func() error { return listenErr }}
	result := make(chan error, 1)
	go func() { result <- serve(context.Background(), server, &recordingLogger{}, 5*time.Second) }()
	if err := awaitServe(t, result); !errors.Is(err, listenErr) {
		t.Fatalf("got %v, want listener failure", err)
	}
}

func TestServeShutsDownOnCancellation(t *testing.T) {
	started := make(chan struct{})
	stopped := make(chan struct{})
	var shutdownCalled bool
	var shutdownDeadline time.Time
	server := stubHTTPServer{
		listen: func() error { close(started); <-stopped; return http.ErrServerClosed },
		shutdown: func(ctx context.Context) error {
			shutdownCalled = true
			shutdownDeadline, _ = ctx.Deadline()
			if err := ctx.Err(); err != nil {
				return err
			}
			close(stopped)
			return nil
		},
	}
	ctx, cancel := context.WithCancel(context.Background())
	defer cancel()
	result := make(chan error, 1)
	go func() { result <- serve(ctx, server, &recordingLogger{}, 5*time.Second) }()
	select {
	case <-started:
	case <-time.After(2 * time.Second):
		t.Fatal("server did not start")
	}
	cancel()
	if err := awaitServe(t, result); err != nil {
		t.Fatal(err)
	}
	if !shutdownCalled || shutdownDeadline.IsZero() || time.Until(shutdownDeadline) > 5*time.Second {
		t.Fatal("shutdown must use a fresh context with a five-second deadline")
	}
}

func TestServeForcesCloseWhenShutdownFails(t *testing.T) {
	shutdownErr := errors.New("shutdown deadline exceeded")
	closeErr := errors.New("close failure")
	ctx, cancel := context.WithCancel(context.Background())
	stopped := make(chan struct{})
	closed := false
	server := stubHTTPServer{
		listen:   func() error { cancel(); <-stopped; return http.ErrServerClosed },
		shutdown: func(context.Context) error { return shutdownErr },
		close:    func() error { closed = true; close(stopped); return closeErr },
	}
	defer cancel()
	result := make(chan error, 1)
	go func() { result <- serve(ctx, server, &recordingLogger{}, 5*time.Second) }()
	err := awaitServe(t, result)
	if !closed || !errors.Is(err, shutdownErr) || !errors.Is(err, closeErr) {
		t.Fatalf("want forced close and both errors, got closed=%v err=%v", closed, err)
	}
}

func TestRequestLimitsIDsAndStructuredErrors(t *testing.T) {
	cfg := configs.Config{Env: configs.PRODUCTION, CORSOrigins: []string{"https://allowed.example"}, HTTPRequestTimeout: time.Second, MaxBodyBytes: 16}
	log := &recordingLogger{}
	router := initializeRouter(cfg, log)
	router.POST("/body", func(ctx *gin.Context) {
		var body map[string]any
		if err := response.DecodeJSON(ctx, &body); err != nil {
			response.Error(ctx, err)
			return
		}
		response.Success(ctx, 200, body)
	})
	router.GET("/deadline", func(ctx *gin.Context) {
		if _, ok := ctx.Request.Context().Deadline(); !ok {
			t.Error("missing request deadline")
		}
		ctx.Status(204)
	})
	for _, tc := range []struct {
		method, path, body string
		status             int
		code               string
	}{
		{"POST", "/body", `{"name":"this exceeds sixteen bytes"}`, 413, "body_too_large"},
		{"GET", "/missing", "", 404, "not_found"},
		{"PUT", "/body", "", 405, "method_not_allowed"},
		{"GET", "/deadline", "", 204, ""},
	} {
		request := httptest.NewRequest(tc.method, tc.path, strings.NewReader(tc.body))
		request.Header.Set("Content-Type", "application/json")
		request.Header.Set("X-Request-ID", "invalid user-controlled value")
		recorder := httptest.NewRecorder()
		router.ServeHTTP(recorder, request)
		if recorder.Code != tc.status {
			t.Fatalf("%s: %d %s", tc.path, recorder.Code, recorder.Body.String())
		}
		id := recorder.Header().Get("X-Request-ID")
		if _, err := uuid.Parse(id); err != nil {
			t.Fatalf("invalid request ID: %q", id)
		}
		if log.fields["request_id"] != id || log.fields["status"] != tc.status || log.fields["method"] != tc.method || log.fields["latency_ms"] == nil {
			t.Fatalf("missing log fields: %#v", log.fields)
		}
		if tc.code != "" {
			var body struct {
				Error struct {
					Code      string `json:"code"`
					RequestID string `json:"request_id"`
				} `json:"error"`
			}
			if err := json.Unmarshal(recorder.Body.Bytes(), &body); err != nil {
				t.Fatal(err)
			}
			if body.Error.Code != tc.code || body.Error.RequestID != id {
				t.Fatalf("unexpected error: %s", recorder.Body.String())
			}
		}
	}
	request := httptest.NewRequest("GET", "/deadline", nil)
	request.Header.Set("Origin", "https://denied.example")
	recorder := httptest.NewRecorder()
	router.ServeHTTP(recorder, request)
	if recorder.Code != 403 || !strings.Contains(recorder.Body.String(), `"code":"origin_not_allowed"`) {
		t.Fatalf("untrusted origin accepted: %d", recorder.Code)
	}
	const upstreamID = "cc639130-7c10-4f91-8515-45a542290e61"
	request = httptest.NewRequest("GET", "/deadline", nil)
	request.Header.Set("X-Request-ID", upstreamID)
	recorder = httptest.NewRecorder()
	router.ServeHTTP(recorder, request)
	if recorder.Header().Get("X-Request-ID") != upstreamID {
		t.Fatal("valid upstream request ID lost")
	}
}

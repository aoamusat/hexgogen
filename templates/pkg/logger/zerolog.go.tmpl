package logger

import (
	"fmt"
	"io"

	"github.com/aoamusat/hexgogen/domain/services"
	"github.com/rs/zerolog"
)

type zerologLog struct {
	client zerolog.Logger
}

var _ services.Logger = (*zerologLog)(nil)

// NewZerolog creates a timestamped JSON logger at the configured minimum level.
func NewZerolog(output io.Writer, level string) (services.Logger, error) {
	parsed, err := zerolog.ParseLevel(level)
	if err != nil {
		return nil, fmt.Errorf("parse log level: %w", err)
	}
	return &zerologLog{client: zerolog.New(output).Level(parsed).With().Timestamp().Logger()}, nil
}

func (log *zerologLog) With(fields map[string]any) services.Logger {
	return &zerologLog{client: log.client.With().Fields(fields).Logger()}
}

func (log *zerologLog) Info(msg string)  { log.client.Info().Msg(msg) }
func (log *zerologLog) Debug(msg string) { log.client.Debug().Msg(msg) }
func (log *zerologLog) Warn(msg string)  { log.client.Warn().Msg(msg) }
func (log *zerologLog) Error(msg string, err error) {
	log.client.Error().Err(err).Msg(msg)
}
